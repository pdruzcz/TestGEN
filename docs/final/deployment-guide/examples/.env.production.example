# =============================================================================
# TestGEN — zmienne srodowiskowe PRODUKCJA
# =============================================================================
# Skopiuj do .env i uzupelnij wartosci oznaczone <...>.
# Nie commituj pliku .env do repozytorium!
# =============================================================================

# === Aplikacja ===
APP_NAME=TestGEN
APP_ENV=production
DEBUG=false
ENGINE_MODE=hybrid

# === Backend — FastAPI ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=<openssl rand -hex 64>

# === JWT (RS256 asymmetric) ===
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === Baza danych — PostgreSQL ===
POSTGRES_USER=testgen
POSTGRES_PASSWORD=<silne_haslo_min_32_znaki>
POSTGRES_DB=testgen
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+asyncpg://testgen:<haslo_postgres>@postgres:5432/testgen

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# === RabbitMQ ===
RABBITMQ_USER=testgen
RABBITMQ_PASSWORD=<silne_haslo>
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://testgen:<haslo_rmq>@rabbitmq:5672//

# === MinIO (S3-compatible storage) ===
MINIO_ROOT_USER=testgen
MINIO_ROOT_PASSWORD=<silne_haslo_min_16_znakow>
MINIO_ENDPOINT=minio:9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false

# === Celery ===
CELERY_BROKER_URL=amqp://testgen:<haslo_rmq>@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC
CELERY_SOFT_TIME_LIMIT=300
CELERY_HARD_TIME_LIMIT=330
CELERY_MAX_RETRIES=3
CELERY_RETRY_DELAYS=[10,60,300]

# Flower (monitoring Celery)
FLOWER_USER=<uzytkownik_flower>
FLOWER_PASSWORD=<silne_haslo_flower>

# === SMTP (Email) ===
SMTP_HOST=<smtp.twoja-domena.pl>
SMTP_PORT=587
SMTP_USER=<noreply@twoja-domena.pl>
SMTP_PASSWORD=<haslo_smtp>
SMTP_FROM_EMAIL=noreply@twoja-domena.pl
SMTP_USE_TLS=true
EMAIL_VERIFICATION_URL_TEMPLATE=https://testgen.example.com/verify-email?token={token}
EMAIL_INVITATION_URL_TEMPLATE=https://testgen.example.com/set-password?token={token}
FRONTEND_BASE_URL=https://testgen.example.com

# === Ciasteczka ===
COOKIE_SECURE=true
COOKIE_DOMAIN=testgen.example.com

# === MFA ===
MFA_TOKEN_EXPIRE_MINUTES=5
ENCRYPTION_KEY=<python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

# === Konto administratora platformy ===
BOOTSTRAP_ADMIN=true
ADMIN_EMAIL=<admin@twoja-domena.pl>
ADMIN_PASSWORD=<silne_haslo_min_12_znakow>

# === Ochrona przed brute-force ===
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
LOGIN_ATTEMPTS_WINDOW_MINUTES=15

# === Frontend — Angular ===
API_URL=https://testgen.example.com/api/v1

# === CORS ===
CORS_ORIGINS=https://testgen.example.com

# === Billing — plany subskrypcji ===
BILLING_BASIC_MONTHLY_PRICE=30.00
BILLING_PREMIUM_MONTHLY_PRICE=50.00
BILLING_CURRENCY=PLN
BILLING_TERMS_URL=https://testgen.example.com/regulamin/
BILLING_PRIVACY_POLICY_URL=https://testgen.example.com/polityka/

# === tpay Open API ===
TPAY_ENV=production
TPAY_BASE_URL=
TPAY_CLIENT_ID=<id_klienta_tpay>
TPAY_CLIENT_SECRET=<sekret_tpay>
TPAY_SECURITY_CODE=<kod_zabezpieczajacy_tpay>
TPAY_MERCHANT_ID=<nr_akceptanta>
TPAY_NOTIFICATION_URL=https://testgen.example.com/api/v1/billing/webhooks/tpay
TPAY_SUCCESS_URL=https://testgen.example.com/billing/checkout/success
TPAY_ERROR_URL=https://testgen.example.com/billing/checkout/error
TPAY_PAYMENT_METHODS_RETURN_URL=https://testgen.example.com/billing/payment-methods/return
TPAY_GROUP_ID_BLIK=150
TPAY_GROUP_ID_CARD=103
TPAY_BLIK_ALIAS_FREQUENCY=eachMonth
TPAY_BLIK_ALIAS_TOTAL_LIMIT_PAYMENTS=12
TPAY_BLIK_ALIAS_EXPIRATION_DAYS=730
TPAY_JWS_CERT_URL=https://secure.tpay.com/x509/notifications-jws.pem

# === LLM Gateway ===
OPENAI_API_KEY=<klucz_openai>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=<klucz_anthropic>
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514
ANTHROPIC_PROXY_URL=
ANTHROPIC_PROXY_TOKEN=
