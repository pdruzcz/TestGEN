# Nazwany etap, bo docker-compose.yml ustawia build.target i compose scala tę
# sekcję z overrideem dev — bez tego dev dziedziczy target „production”.
FROM node:22-alpine AS development

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

EXPOSE 4200

CMD ["npx", "ng", "serve", "--host", "0.0.0.0", "--port", "4200", "--poll", "2000"]
