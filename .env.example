# =========================
# Application
# =========================
APP_NAME=TestGEN
APP_ENV=development
DEBUG=true
ENGINE_MODE=hybrid

# =========================
# Backend — FastAPI
# =========================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-in-production

# =========================
# JWT (RS256 asymmetric)
# =========================
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =========================
# Database — PostgreSQL
# =========================
POSTGRES_USER=testgen
POSTGRES_PASSWORD=testgen_dev_password
POSTGRES_DB=testgen
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Port, pod którym baza jest widoczna z hosta. Ustaw inny, jeśli 5432 jest
# już zajęty — nie wpływa na połączenia wewnątrz sieci compose.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+asyncpg://testgen:testgen_dev_password@postgres:5432/testgen

# =========================
# Redis
# =========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# =========================
# RabbitMQ
# =========================
RABBITMQ_USER=testgen
RABBITMQ_PASSWORD=testgen_dev_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://testgen:testgen_dev_password@rabbitmq:5672//

# =========================
# MinIO (S3-compatible storage)
# =========================
MINIO_ROOT_USER=testgen
MINIO_ROOT_PASSWORD=testgen_dev_password
MINIO_ENDPOINT=minio:9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false

# =========================
# Celery
# =========================
CELERY_BROKER_URL=amqp://testgen:testgen_dev_password@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC
CELERY_SOFT_TIME_LIMIT=300
CELERY_HARD_TIME_LIMIT=330
CELERY_MAX_RETRIES=3
CELERY_RETRY_DELAYS=[10,60,300]

# Flower (monitoring UI Celery, port 5555) — basic-auth
FLOWER_USER=floweradmin
FLOWER_PASSWORD=flower_dev_password

# =========================
# SMTP (Email)
# =========================
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@testgen.io
SMTP_USE_TLS=true
EMAIL_VERIFICATION_URL_TEMPLATE=http://localhost:4200/verify-email?token={token}
EMAIL_INVITATION_URL_TEMPLATE=http://localhost:4200/set-password?token={token}
EMAIL_PASSWORD_RESET_URL_TEMPLATE=http://localhost:4200/reset-password?token={token}
# Baza URL frontendu do CTA w emailach (Story 7.11 — „Uaktualnij plan”)
FRONTEND_BASE_URL=http://localhost:4200

# =========================
# Integracje SCM — GitHub (Epic 8, Story 8.1)
# =========================
# OAuth App: https://github.com/settings/developers
# Callback URL w ustawieniach aplikacji musi się zgadzać z GITHUB_REDIRECT_URI.
# Puste GITHUB_CLIENT_ID wyłącza integrację (endpoint /authorize zwraca 503).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback
# Publiczny adres API — pod ten adres GitHub wysyła webhooki, więc localhost
# zadziała wyłącznie za tunelem (ngrok, cloudflared).
API_PUBLIC_BASE_URL=http://localhost:8000
# Gałęzie, których push uruchamia analizę (lista JSON) — wspólne dla GitHub i GitLab
SCM_ANALYZED_BRANCHES=["main","master"]

# =========================
# Integracje SCM — GitLab (Epic 8, Story 8.2)
# =========================
# OAuth Application: {instancja}/-/profile/applications (scope: api)
# Działa z gitlab.com i z instancjami self-hosted — adres instancji podaje
# użytkownik przy łączeniu, GITLAB_DEFAULT_URL to tylko domyślna wartość pola.
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gitlab/callback
GITLAB_DEFAULT_URL=https://gitlab.com

# =========================
# Cookies
# =========================
COOKIE_SECURE=false
COOKIE_DOMAIN=

# =========================
# MFA
# =========================
MFA_TOKEN_EXPIRE_MINUTES=5
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# =========================
# Admin Bootstrap
# =========================
# When BOOTSTRAP_ADMIN=true, creates a platform admin on startup if none exists.
# Admin is created as active + verified with the system tenant (__system__).
BOOTSTRAP_ADMIN=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# =========================
# Brute Force Protection
# =========================
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
LOGIN_ATTEMPTS_WINDOW_MINUTES=15

# =========================
# Frontend — Angular
# =========================
API_URL=http://localhost:8000/api/v1

# =========================
# CORS
# =========================
CORS_ORIGINS=http://localhost:4200,http://localhost:8000

# =========================
# Billing — plany subskrypcji (Story 7.1, §3.2a plan-integracji-tpay.md)
# =========================
# Ceny miesięczne (jedyny cykl — bez rocznych). Sandbox tpay: kwoty testowe
# sterujące scenariuszami płatności; produkcja: 30/50 PLN.
# Wymiana cen = zmiana env + restart (idempotentny re-seed), bez deployu kodu.
BILLING_BASIC_MONTHLY_PRICE=30.00
BILLING_PREMIUM_MONTHLY_PRICE=50.00
BILLING_CURRENCY=PLN
# Dokumenty prawne — tpay wymaga osadzenia regulaminu i polityki prywatności
# na stronach związanych z zakupami (linki z configu, nigdy hardcode).
BILLING_TERMS_URL=https://test-gen.pl/regulamin/
BILLING_PRIVACY_POLICY_URL=https://test-gen.pl/polityka/

# =========================
# tpay Open API — Story 7.4 (§3.2 plan-integracji-tpay.md)
# =========================
# Sekrety (TPAY_CLIENT_SECRET, TPAY_SECURITY_CODE) wyłącznie przez env/secrets —
# nigdy w kodzie/repo (wymóg tpay). Wartości poniżej są puste — uzupełnić
# per środowisko (sandbox: Panel https://panel.sandbox.tpay.com).
# Środowisko: sandbox | production. Puste TPAY_BASE_URL → pochodna od TPAY_ENV
# (https://openapi.sandbox.tpay.com / https://api.tpay.com).
TPAY_ENV=sandbox
TPAY_BASE_URL=
TPAY_CLIENT_ID=
TPAY_CLIENT_SECRET=
# Kod zabezpieczający (Panel → Powiadomienia → Zabezpieczenia) — do wzoru md5sum.
TPAY_SECURITY_CODE=
# Numer akceptanta (login panelu) — pierwszy składnik wzoru md5sum.
TPAY_MERCHANT_ID=
# URL notyfikacji transakcyjnej (publiczna domena; nadpisywany per-transakcja).
TPAY_NOTIFICATION_URL=https://testgen.nexio.pl/api/v1/billing/webhooks/tpay
# Strony powrotu płatnika (Angular — /billing/checkout/success|error).
TPAY_SUCCESS_URL=https://testgen.nexio.pl/billing/checkout/success
TPAY_ERROR_URL=https://testgen.nexio.pl/billing/checkout/error
# Powrót z rejestracji karty bez obciążenia (callbackUrl POST /tokens — 7.2).
TPAY_PAYMENT_METHODS_RETURN_URL=https://testgen.nexio.pl/billing/payment-methods/return
# Grupy płatności Panelu Transakcyjnego: 150 = BLIK, 103 = karta.
TPAY_GROUP_ID_BLIK=150
TPAY_GROUP_ID_CARD=103
# Ograniczenia aliasu BLIK Płatności Powtarzalne (PAYID, model A — 7.2 AC4):
# limit pojedynczy = cena planu; całkowity = cena × liczba płatności; horyzont w dniach.
TPAY_BLIK_ALIAS_FREQUENCY=eachMonth
TPAY_BLIK_ALIAS_TOTAL_LIMIT_PAYMENTS=12
TPAY_BLIK_ALIAS_EXPIRATION_DAYS=730
# Certyfikat x509 do weryfikacji JWS notyfikacji (pobierany i cache'owany).
TPAY_JWS_CERT_URL=https://secure.tpay.com/x509/notifications-jws.pem

# =========================
# LLM Gateway
# =========================
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Anthropic (standard API)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514
# Anthropic-compatible proxy (e.g., z.ai) — optional. When set, the gateway
# routes through PROXY_URL authenticating with PROXY_TOKEN instead of the
# standard ANTHROPIC_API_KEY against ANTHROPIC_BASE_URL.
# Example (z.ai): ANTHROPIC_PROXY_URL=https://api.z.ai/api/anthropic
ANTHROPIC_PROXY_URL=
ANTHROPIC_PROXY_TOKEN=
