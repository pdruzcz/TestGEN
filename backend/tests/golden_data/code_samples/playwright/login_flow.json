{
  "name": "Login flow",
  "description": "User login flow — semantyczne selektory (getByRole, getByPlaceholder, getByText)",
  "url": "https://example.com/login",
  "test_cases": [
    {
      "scenario_name": "Successful login",
      "test_type": "e2e",
      "url": "https://example.com/login",
      "ui_elements": [
        {
          "name": "username_input",
          "locator_type": "placeholder",
          "locator_value": "Username",
          "element_type": "input",
          "page_name": "LoginPage"
        },
        {
          "name": "password_input",
          "locator_type": "placeholder",
          "locator_value": "Password",
          "element_type": "input",
          "page_name": "LoginPage"
        },
        {
          "name": "login_button",
          "locator_type": "role",
          "locator_value": "button",
          "element_type": "button",
          "page_name": "LoginPage",
          "role_name": "Submit"
        },
        {
          "name": "welcome_message",
          "locator_type": "text",
          "locator_value": "Welcome",
          "element_type": "text",
          "page_name": "DashboardPage"
        }
      ],
      "user_flow": {
        "name": "Login flow",
        "url": "https://example.com/login",
        "steps": [
          {"action": "fill", "element": {"name": "username_input"}, "value": "testuser"},
          {"action": "fill", "element": {"name": "password_input"}, "value": "password123"},
          {"action": "click", "element": {"name": "login_button"}}
        ]
      },
      "expected_result": "Welcome",
      "comparison_type": "text_contains",
      "assertions": [
        {"type": "text_contains", "element": "welcome_message", "expected": "Welcome"}
      ]
    },
    {
      "scenario_name": "Login with empty fields",
      "test_type": "e2e",
      "url": "https://example.com/login",
      "ui_elements": [
        {
          "name": "username_input",
          "locator_type": "placeholder",
          "locator_value": "Username",
          "element_type": "input",
          "page_name": "LoginPage"
        },
        {
          "name": "error_message",
          "locator_type": "text",
          "locator_value": "required",
          "element_type": "text",
          "page_name": "LoginPage"
        }
      ],
      "user_flow": {
        "name": "Empty login",
        "url": "https://example.com/login",
        "steps": [
          {"action": "click", "element": {"name": "username_input"}}
        ]
      },
      "expected_result": "required",
      "comparison_type": "text_contains"
    }
  ]
}
