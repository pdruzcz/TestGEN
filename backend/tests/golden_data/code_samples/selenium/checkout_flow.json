{
  "name": "Checkout flow",
  "description": "E-commerce checkout flow — cart, shipping, payment, confirmation",
  "url": "https://shop.example.com",
  "test_cases": [
    {
      "scenario_name": "Complete checkout",
      "test_type": "e2e",
      "url": "https://shop.example.com/checkout",
      "ui_elements": [
        {
          "name": "cart_item",
          "locator_type": "xpath",
          "locator_value": "//div[@class='cart-item']",
          "element_type": "text",
          "page_name": "CartPage"
        },
        {
          "name": "proceed_button",
          "locator_type": "css",
          "locator_value": ".proceed-checkout",
          "element_type": "button",
          "page_name": "CartPage"
        },
        {
          "name": "shipping_address",
          "locator_type": "id",
          "locator_value": "shipping-address",
          "element_type": "input",
          "page_name": "ShippingPage"
        },
        {
          "name": "place_order_button",
          "locator_type": "css",
          "locator_value": "#place-order",
          "element_type": "button",
          "page_name": "PaymentPage"
        },
        {
          "name": "confirmation_text",
          "locator_type": "css",
          "locator_value": ".order-confirmation",
          "element_type": "text",
          "page_name": "ConfirmationPage"
        }
      ],
      "user_flow": {
        "name": "Checkout flow",
        "url": "https://shop.example.com/checkout",
        "steps": [
          {"action": "click", "element": {"name": "proceed_button"}},
          {"action": "fill", "element": {"name": "shipping_address"}, "value": "123 Main St"},
          {"action": "click", "element": {"name": "place_order_button"}}
        ]
      },
      "expected_result": "Order confirmed",
      "comparison_type": "text_contains",
      "assertions": [
        {"type": "text_contains", "element": "confirmation_text", "expected": "Order confirmed"}
      ]
    }
  ]
}
