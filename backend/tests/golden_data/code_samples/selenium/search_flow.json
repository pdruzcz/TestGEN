{
  "name": "Search flow",
  "description": "Product search flow z XPath lokatorami i asercjami URL",
  "url": "https://shop.example.com",
  "test_cases": [
    {
      "scenario_name": "Search for products",
      "test_type": "e2e",
      "url": "https://shop.example.com/search",
      "ui_elements": [
        {
          "name": "search_bar",
          "locator_type": "xpath",
          "locator_value": "//input[@placeholder='Search products...']",
          "element_type": "input",
          "page_name": "SearchPage"
        },
        {
          "name": "search_button",
          "locator_type": "css",
          "locator_value": "button.search-submit",
          "element_type": "button",
          "page_name": "SearchPage"
        },
        {
          "name": "results_count",
          "locator_type": "css",
          "locator_value": ".results-count",
          "element_type": "text",
          "page_name": "ResultsPage"
        }
      ],
      "user_flow": {
        "name": "Search flow",
        "url": "https://shop.example.com/search",
        "steps": [
          {"action": "fill", "element": {"name": "search_bar"}, "value": "laptop"},
          {"action": "click", "element": {"name": "search_button"}}
        ]
      },
      "expected_result": "results found",
      "comparison_type": "text_contains"
    },
    {
      "scenario_name": "Empty search shows no results",
      "test_type": "e2e",
      "url": "https://shop.example.com/search",
      "ui_elements": [
        {
          "name": "search_bar",
          "locator_type": "xpath",
          "locator_value": "//input[@placeholder='Search products...']",
          "element_type": "input",
          "page_name": "SearchPage"
        },
        {
          "name": "no_results_message",
          "locator_type": "css",
          "locator_value": ".no-results",
          "element_type": "text",
          "page_name": "ResultsPage"
        }
      ],
      "user_flow": {
        "name": "Empty search",
        "url": "https://shop.example.com/search",
        "steps": [
          {"action": "fill", "element": {"name": "search_bar"}, "value": ""},
          {"action": "click", "element": {"name": "search_button"}}
        ]
      },
      "expected_result": "No results",
      "comparison_type": "text_contains"
    }
  ]
}
