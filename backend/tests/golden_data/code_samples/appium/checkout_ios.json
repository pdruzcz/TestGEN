{
  "description": "Checkout flow na aplikacji iOS",
  "platform": "ios",
  "test_cases": [
    {
      "scenario_name": "Product checkout on iOS",
      "test_type": "e2e",
      "ui_elements": [
        {
          "name": "product_list",
          "locator_type": "accessibility_id",
          "locator_value": "product-list",
          "element_type": "generic",
          "page_name": "CatalogScreen"
        },
        {
          "name": "add_to_cart_btn",
          "locator_type": "accessibility_id",
          "locator_value": "add-to-cart-button",
          "element_type": "button",
          "page_name": "ProductScreen"
        },
        {
          "name": "cart_badge",
          "locator_type": "xpath",
          "locator_value": "//XCUIElementTypeStaticText[@name='cart-badge']",
          "element_type": "text",
          "page_name": "ProductScreen"
        },
        {
          "name": "checkout_button",
          "locator_type": "accessibility_id",
          "locator_value": "checkout-button",
          "element_type": "button",
          "page_name": "CartScreen"
        }
      ],
      "user_flow": {
        "name": "Checkout flow",
        "steps": [
          {"action": "click", "element": {"name": "product_list"}},
          {"action": "click", "element": {"name": "add_to_cart_btn"}},
          {"action": "click", "element": {"name": "checkout_button"}}
        ]
      },
      "expected_result": "Order confirmed",
      "comparison_type": "text_contains",
      "assertions": [
        {"type": "element_visible", "element": "cart_badge", "expected": "cart badge"}
      ]
    }
  ]
}
