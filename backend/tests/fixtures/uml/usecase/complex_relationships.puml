actor "Gość" as Guest
actor "Zarejestrowany" as Member
actor "Premium" as Premium
Member --|> Guest
Premium --|> Member
usecase "Przeglądaj katalog" as UC1
usecase "Zarejestruj się" as UC2
usecase "Złóż zamówienie" as UC3
usecase "Walidacja płatności" as UC4
