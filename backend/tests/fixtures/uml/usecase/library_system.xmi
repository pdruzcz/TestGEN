<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1"
         xmlns:xmi="http://schema.omg.org/spec/XMI/2.1"
         xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">
  <uml:Model xmi:id="model_1" name="LibrarySystem">
    <packagedElement xmi:type="uml:Actor" xmi:id="actor_reader" name="Reader"/>
    <packagedElement xmi:type="uml:Actor" xmi:id="actor_librarian" name="Librarian"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_search" name="SearchCatalog"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_borrow" name="BorrowBook">
      <include xmi:type="uml:Include" xmi:id="inc_1" addition="uc_auth"/>
    </packagedElement>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_return" name="ReturnBook"/>
    <packagedElement xmi:type="uml:UseCase" xmi:id="uc_auth" name="Authenticate"/>
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_1" memberEnd="end_reader end_search">
      <ownedEnd xmi:type="uml:Property" xmi:id="end_reader" type="actor_reader"/>
      <ownedEnd xmi:type="uml:Property" xmi:id="end_search" type="uc_search"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_2" memberEnd="end_reader2 end_borrow">
      <ownedEnd xmi:type="uml:Property" xmi:id="end_reader2" type="actor_reader"/>
      <ownedEnd xmi:type="uml:Property" xmi:id="end_borrow" type="uc_borrow"/>
    </packagedElement>
  </uml:Model>
</xmi:XMI>
