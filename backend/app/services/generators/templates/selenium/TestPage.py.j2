{# ── Szablon Selenium WebDriver — Python ── Story 1.40 ── #}
{# ── Makro: render_locator ── Generuje lokator elementu ── #}
{% macro render_locator(locator) -%}
_{{ locator.name }} = ({{ locator.code }})
{%- endmacro %}


{# ── Makro: render_wait ── Generuje explicit wait ── #}
{% macro render_wait(wait_spec) -%}
{{ wait_spec.code }}
{%- endmacro %}


{# ── Makro: render_assertion ── Generuje asercje ── #}
{% macro render_assertion(assertion) -%}
{{ assertion.code }}
{%- endmacro %}


{# ── Importy Selenium ── #}
{% for imp in imports %}
{{ imp }}
{% endfor %}

"""
Testy Selenium WebDriver — {{ module_name }}.

Wygenerowano automatycznie przez TestGEN - silnik natywny (Selenium).
Nie modyfikuj recznie; zmiany zostana nadpisane przy kolejnej generacji.
"""


{% for pom in page_objects %}
class {{ pom.class_name }}:
    """Page Object Model: {{ pom.page_name }}."""

    def __init__(self, driver):
        self.driver = driver
        self.wait = WebDriverWait(driver, 10)

    {% for locator in pom.locators %}
    {{ render_locator(locator) }}
    {% endfor %}

    {% for method in pom.methods %}
    def {{ method.name }}(self{{ method.params }}):
        {% for action in method.actions %}
        {{ action.code }}
        {% endfor %}

    {% endfor %}

{% endfor %}
class {{ test_class_name }}:
    """Testy Selenium: {{ module_name }}."""

    def setup_method(self):
        """Konfiguracja ChromeDriver."""
        options = webdriver.ChromeOptions()
        {% for opt_line in driver_setup.options_lines %}
        {{ opt_line }}
        {% endfor %}
        {{ driver_setup.driver_init }}
        {{ driver_setup.wait_init }}

    def teardown_method(self):
        """Zamknij przegladarke."""
        {{ teardown.quit }}

    {% for test in test_methods %}
    def {{ test.name }}(self):
        """Test: {{ test.scenario }}."""
        {% if test.url %}
        self.driver.get("{{ test.url }}")
        {% endif %}
        {% for wait in test.waits %}
        {{ render_wait(wait) }}
        {% endfor %}
        {% for pom_call in test.pom_calls %}
        {{ pom_call.call }}
        {% endfor %}
        {% for assertion in test.assertions %}
        {{ render_assertion(assertion) }}
        {% endfor %}
        {% if not test.pom_calls and not test.assertions %}
        pass  # TODO: dodaj kroki testowe i asercje
        {% endif %}

    {% endfor %}
