{# ── Szablon Selenium WebDriver — Java ── Story 1.40 ── #}
{# ── Makro: render_locator_java ── Generuje lokator elementu ── #}
{% macro render_locator_java(locator) -%}
private By {{ locator.name }} = {{ locator.code }};
{%- endmacro %}


{# ── Makro: render_wait_java ── Generuje explicit wait ── #}
{% macro render_wait_java(wait_spec) -%}
{{ wait_spec.code }}
{%- endmacro %}


{# ── Makro: render_assertion_java ── Generuje asercje ── #}
{% macro render_assertion_java(assertion) -%}
{{ assertion.code }}
{%- endmacro %}


{# ── Importy Selenium ── #}
{% for imp in imports %}
{{ imp }}
{% endfor %}

/**
 * Testy Selenium WebDriver — {{ module_name }}.
 *
 * Wygenerowano automatycznie przez TestGEN - silnik natywny (Selenium).
 * Nie modyfikuj recznie; zmiany zostana nadpisane przy kolejnej generacji.
 */


{% for pom in page_objects %}
public class {{ pom.class_name }} {
    private WebDriver driver;
    private WebDriverWait wait;

    {% for locator in pom.locators %}
    {{ render_locator_java(locator) }}
    {% endfor %}

    public {{ pom.class_name }}(WebDriver driver) {
        this.driver = driver;
        this.wait = new WebDriverWait(driver, Duration.ofSeconds(10));
    }

    {% for method in pom.methods %}
    public {{ method.returns }} {{ method.name }}({{ method.params | replace("^, ", "") }}) {
        {% for action in method.actions %}
        {{ action.code }}
        {% endfor %}
    }

    {% endfor %}
}
{% endfor %}

public class {{ test_class_name }} {
    private WebDriver driver;
    private WebDriverWait wait;

    @BeforeEach
    void setUp() {
        ChromeOptions options = new ChromeOptions();
        {% for opt_line in driver_setup.options_lines %}
        {{ opt_line }}
        {% endfor %}
        {{ driver_setup.driver_init }};
        {{ driver_setup.wait_init }};
    }

    @AfterEach
    void tearDown() {
        {{ teardown.quit }};
    }

    {% for test in test_methods %}
    @Test
    void {{ test.name }}() {
        {% if test.url %}
        driver.get("{{ test.url }}");
        {% endif %}
        {% for wait in test.waits %}
        {{ render_wait_java(wait) }}
        {% endfor %}
        {% for pom_call in test.pom_calls %}
        {{ pom_call.call }}
        {% endfor %}
        {% for assertion in test.assertions %}
        {{ render_assertion_java(assertion) }}
        {% endfor %}
        {% if not test.pom_calls and not test.assertions %}
        // TODO: dodaj kroki testowe i asercje
        {% endif %}
    }

    {% endfor %}
}
