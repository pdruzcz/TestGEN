"""

import pytest
{% if test_functions | selectattr("mocks", "defined") | selectattr("mocks", "ne", none) | list | length > 0 %}
import unittest.mock
{% endif -%}
{% if imports %}
{% for imp in imports %}
{{ imp }}
{% endfor %}
{% endif -%}


{% if fixtures %}
# ── Fixtures ──

{% for fixture in fixtures %}
{{ render_fixture(fixture) }}
{% endfor %}
{% endif -%}

{% if test_functions %}
{% for test_func in test_functions %}
{{ render_test_function(test_func) }}
{% endfor %}
{% else %}
# Brak funkcji testowych do wygenerowania
{% endif -%}
