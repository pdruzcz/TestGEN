      // TODO: dodaj kroki testowe i asercje
{% endif %}
  {% if test.parameterized and test.test_each_data %}
    });
  });
  {% else %}
  });
  {% endif %}
{%- endmacro %}


{# ── Plik testowy TypeScript ── #}
{% for imp in imports %}
{{ imp }}
{% endfor %}

/**
 * Testy modulu {{ test_module_name }}.
 *
 * Wygenerowano automatycznie przez TestGEN - silnik natywny ({% if is_jest %}Jest{% else %}Mocha+Chai{% endif %}, TypeScript).
 * Nie modyfikuj recznie; zmiany zostana nadpisane przy kolejnej generacji.
 */
describe('{{ test_module_name }}', () => {
{% if has_lifecycle %}
  beforeEach(() => {
{% if is_mocha and mocks %}
    const sandbox: sinon.SinonSandbox = sinon.createSandbox();
{% endif %}
{% for step in setup_steps %}
    {{ step.code }}
{% endfor %}
  });

{% if has_teardown %}

  afterEach(() => {
{% if is_jest and mocks %}
    jest.restoreAllMocks();
{% elif is_mocha and mocks %}
    sandbox.restore();
{% endif %}
{% for step in teardown_steps %}
    {{ step.code }}
{% endfor %}
  });

{% endif %}
{% endif %}
{% for mock in mocks %}
  {{ render_mock_field(mock, variant) }}
{% endfor %}

{% for test in test_cases %}
{{ render_test_method(test, variant) }}

{% endfor %}
});
