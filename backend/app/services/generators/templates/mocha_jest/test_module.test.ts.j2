  describe.each({{ test.test_each_data }})(
    '{{ test.description }}',
    ({% for p in test.parameters %}{{ p.name }}: {{ p.type }}{% if not loop.last %}, {% endif %}{% endfor %}) => {
    it('should pass', {% if test.is_async %}async {% endif %}() => {
    {% else %}
  describe.each({{ test.test_each_data }})(
    '{{ test.description }}',
    ({% for p in test.parameters %}{{ p.name }}: {{ p.type }}{% if not loop.last %}, {% endif %}{% endfor %}) => {
    it('should pass', {% if test.is_async %}async {% endif %}() => {
    {% endif %}
  {% else %}
  it('{{ test.description }}', {% if test.is_async %}async {% endif %}() => {
  {% endif %}
{% if test.mock_stubbing %}
{% for stub in test.mock_stubbing %}
      {{ stub.code }}
{% endfor %}
