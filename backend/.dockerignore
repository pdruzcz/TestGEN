# Wirtualne środowisko hosta — 239 MB kopiowane do kontekstu każdego z sześciu
# serwisów backendowych, a obraz i tak instaluje zależności od zera.
.venv/
venv/

# Cache narzędzi i artefakty lokalne
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Lokalna konfiguracja i sekrety
.env
.env.*
!.env.example

# Dane robocze generowane przez uruchomienia lokalne
data/
logs/
*.log
